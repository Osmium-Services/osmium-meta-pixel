<?php // Included via ServiceThemeBlocks::render('head', [...]) by a real theme's
// own <head> template - see that class's doc comment. Expects $site (for the
// environment check) and $metaPixel (this service's config, injected by the
// loader) in the render context.
//
// This service requires Cookie Consent to be installed (service.json
// requires.services), but has no PHP-level coupling to it.
//
// Consent: the pixel is initialised with consent revoked, which stops Meta
// setting cookies or sending events. For a visitor whose cookie already reads
// 'accepted' consent is granted before init instead (granting after the
// PageView was measured to leave it unsent). Otherwise it is granted only if
// window.OsmiumCookieConsent.cookieName (a documented client-side convention,
// set by whatever consent service is on the page, if any; falls back to the
// default cookie name so block render order doesn't matter) reads 'accepted'.
// Cookie Consent's accept/reject buttons fire an 'osmium:consent' event, which this block listens for.
// With no consent service present the pixel stays revoked, so this errs
// towards not tracking. No <noscript> pixel fallback: it would fire without
// consent, and visitors without JS can't give consent via the banner. ?>
<?php
// $metaPixel is this service's own config, injected by the loader under its
// service id (see ServiceLoader::serviceConfigContext()). Deliberately not read
// via MetaPixelConfig::get() here: if its class can't be autoloaded (e.g. right
// after an install) the page would fatal, whereas an absent context just
// renders nothing.
$pixelEnabled = $metaPixel['enabled'] ?? false;
$pixelId = (string) ($metaPixel['pixelId'] ?? '');
$pixelIdValid = \preg_match(pattern: '/^\d{15,16}$/', subject: $pixelId) === 1; // Same rule as MetaPixelConfig::isValidPixelId()
$isProduction = !\in_array($site['environment'] ?? '', ['dev', 'staging'], true);
$shouldLoad = $pixelEnabled && $pixelIdValid && $isProduction; // Pixel only on production
$shopEvents = (bool) ($metaPixel['shopEvents'] ?? false); // The access token in $metaPixel is never printed here
?>
<?php if ($shouldLoad): ?>
    <link rel="preconnect" href="https://connect.facebook.net" />
    <!-- Meta Pixel (deferred until idle or first interaction; consent revoked until accepted) -->
    <script>
        (function(w, d, s, pixelId) {
            if (w.fbq) return;
            var n = w.fbq = function() {
                n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!w._fbq) w._fbq = n;
            n.push = n;
            n.loaded = true;
            n.version = '2.0';
            n.queue = [];

            var cookieName = (w.OsmiumCookieConsent && w.OsmiumCookieConsent.cookieName) || 'osmium_cookie_consent';
            var m = cookieName ? d.cookie.match(new RegExp('(?:^|; )' + cookieName + '=([^;]*)')) : null;
            var accepted = !!m && decodeURIComponent(m[1]) === 'accepted';

            w.fbq('consent', accepted ? 'grant' : 'revoke');
            w.fbq('init', pixelId);
            w.fbq('track', 'PageView');

            // Live update when a consent tool fires 'osmium:consent' (detail.value 'accepted' / 'rejected').
            d.addEventListener('osmium:consent', function(e) {
                w.fbq('consent', e.detail && e.detail.value === 'accepted' ? 'grant' : 'revoke');
            });

<?php if ($shopEvents): ?>
            // Shop events. Consent is still revoked here until the visitor accepts, so Meta holds these until then.
            // Core's osmium:shop-event (view_item, purchase) and osmium:basket-added (add to cart) are vendor-neutral;
            // this maps them to Meta's standard events.
            function money(n) { return Math.round(Number(n) * 100) / 100; }

            function onShopEvent(detail) {
                if (!detail) return;
                if (detail.type === 'view_item') {
                    w.fbq('track', 'ViewContent', {
                        content_ids: [String(detail.product_id)],
                        content_type: 'product',
                        content_name: detail.title,
                        value: money(detail.value),
                        currency: detail.currency
                    });
                } else if (detail.type === 'purchase') {
                    var items = detail.items || [];
                    var count = 0;
                    items.forEach(function(i) { count += i.quantity; });
                    w.fbq('track', 'Purchase', {
                        value: money(detail.value),
                        currency: detail.currency,
                        content_type: 'product',
                        content_ids: items.map(function(i) { return String(i.product_id); }),
                        contents: items.map(function(i) { return { id: String(i.product_id), quantity: i.quantity, item_price: i.unit_price_inc_tax }; }),
                        num_items: count
                    }, { eventID: detail.order_ref }); // Same id the server Purchase uses, so Meta counts the sale once
                }
            }

            (w.osmiumShopEvents || []).forEach(onShopEvent); // Fired before this block's listener existed
            d.addEventListener('osmium:shop-event', function(e) { onShopEvent(e.detail); });

            d.addEventListener('osmium:basket-added', function(e) {
                var link = e.target;
                var productId = link && link.getAttribute ? link.getAttribute('data-product-id') : null;
                if (!productId) return;

                var form = link.closest('form');
                var qtyField = form ? form.querySelector('#qty') : null;
                var qty = (qtyField && parseInt(qtyField.value, 10)) || 1;

                var params = { content_ids: [String(productId)], content_type: 'product', contents: [{ id: String(productId), quantity: qty }] };

                // The basket response prices the whole line, so work out one unit and multiply by what was added.
                var lines = (e.detail && e.detail.lines) || [];
                for (var i = 0; i < lines.length; i++) {
                    if (String(lines[i].product_id) !== String(productId) || !lines[i].quantity) continue;
                    var unit = (Number(lines[i].line_total_exc_tax) + Number(lines[i].line_tax_amount)) / lines[i].quantity;
                    if (isFinite(unit)) {
                        params.value = money(unit * qty);
                        params.contents[0].item_price = money(unit);
                        params.currency = (e.detail && e.detail.currency) || undefined;
                    }
                    break;
                }

                w.fbq('track', 'AddToCart', params);
            });
<?php endif; ?>

            var loaded = false;

            function load() {
                if (loaded) return;
                loaded = true;
                var t = d.createElement(s),
                    f = d.getElementsByTagName(s)[0];
                t.async = true;
                t.src = 'https://connect.facebook.net/en_US/fbevents.js';
                f.parentNode.insertBefore(t, f);
                events.forEach(function(e) {
                    w.removeEventListener(e, load);
                });
                clearTimeout(idleTimer);
            }
            var events = ['scroll', 'click', 'keydown', 'touchstart', 'mousemove'];
            events.forEach(function(e) {
                w.addEventListener(e, load, {
                    passive: true,
                    once: true
                });
            });
            var idleTimer = setTimeout(load, 5000);
        })(window, document, 'script', '<?php echo \htmlspecialchars($pixelId, ENT_QUOTES); ?>');
    </script>
    <!-- End Meta Pixel -->
<?php endif; ?>
